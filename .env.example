# Copy to .env (gitignored) and fill in. Only the cloud:* tasks load it, so
# nothing here reaches the proxy, conformance, or e2e runs.
#
#   cp .env.example .env

# Your Comfy API key, for Comfy Cloud (v2 jobs and assets) and Comfy Router
# (client.Models). Required by every cloud:* task.
COMFY_API_KEY=

# Optional: point the Router calls at another deployment.
# Default https://api.comfy.org.
# COMFY_ROUTER_BASE_URL=https://api.comfy.org
