{{define "site-head"}}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.title}}</title>
<meta name="description" content="{{.description}}">
{{with .canonical}}<link rel="canonical" href="{{.}}">
<meta property="og:url" content="{{.}}">{{end}}
<meta property="og:site_name" content="comfy-api-proxy-go">
<meta property="og:title" content="{{.title}}">
<meta property="og:description" content="{{.description}}">
<meta property="og:type" content="{{if .page}}article{{else}}website{{end}}">
<meta property="og:image" content="{{$.ogImage}}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="comfy-api-proxy-go: the Comfy API v2 in front of your own ComfyUI, as one Go binary. Independent project, not affiliated with Comfy Org.">
<meta name="twitter:card" content="summary_large_image">
<meta name="color-scheme" content="dark light">
<link rel="icon" href="{{asset "/static/img/favicon.svg"}}" type="image/svg+xml">
<link rel="describedby" href="/llms.txt">
<link rel="preload" href="/static/fonts/inter/InterVariable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{asset "/static/css/site.css"}}">
<meta name="htmx-config" content='{"includeIndicatorCSS":false,"transitions":false}'>
<script src="{{asset "/static/js/theme.js"}}"></script>
{{end}}

{{define "site-header"}}
<a class="skip-link" href="#main">Skip to content</a>
<p class="notice-bar" role="note">Independent project. Not affiliated with or endorsed by Comfy Org.</p>
<header class="site-header">
  <a class="brand" href="/" aria-label="comfy-api-proxy-go home"{{if eq .current "home"}} aria-current="page"{{end}}>
    <img class="brand-mark" src="{{asset "/static/img/favicon.svg"}}" alt="" width="24" height="24">
    <span>comfy-api-proxy<span class="brand-go">-go</span></span>
  </a>
  <nav class="site-nav" aria-label="Primary">
    <a href="/docs/introduction"{{if and (eq .current "docs") (ne .topic "api") (ne .topic "sdk")}} aria-current="page"{{end}}>Docs</a>
    <a href="/docs/api"{{if eq .topic "api"}} aria-current="page"{{end}}>API</a>
    <a href="/docs/sdk"{{if eq .topic "sdk"}} aria-current="page"{{end}}>SDK</a>
    <a href="{{$.repo}}">GitHub<span class="sr-only"> (source code)</span></a>
    <button type="button" class="theme-toggle" data-theme-toggle hidden aria-label="Switch to the light theme">
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor"/></svg>
    </button>
  </nav>
</header>
{{end}}

{{define "site-footer"}}
<footer class="site-footer">
  <p class="footer-name">comfy-api-proxy-go</p>
  <p class="footer-disclaimer">comfy-api-proxy-go is an independent, community Go port of Comfy-Org's comfy-api-proxy. It is not an official ComfyUI or Comfy Org project and is not affiliated with or endorsed by Comfy Org. Comfy and ComfyUI are trademarks of Comfy Org.</p>
  <nav class="footer-links" aria-label="Footer">
    <a href="/docs/introduction">Documentation</a>
    <a href="{{$.repo}}">Source on GitHub</a>
    <a href="{{$.repo}}/blob/main/LICENSE">MIT License</a>
    <a href="{{$.repo}}/blob/main/SECURITY.md">Security policy</a>
    <a href="/llms.txt">llms.txt</a>
  </nav>
</footer>
{{end}}

{{define "site-scripts"}}
<script src="{{asset "/static/js/htmx.min.js"}}"></script>
<script src="{{asset "/static/js/site.js"}}"></script>
{{end}}
